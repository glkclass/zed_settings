// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && extension == py",
    "bindings": {
      "F7": ["task::Spawn", { "task_name": "Python: Run Active File" }]
    }
  },
  {
    "context": "Editor && (extension == v || extension == sv || extension == vh|| extension == svh)",
    "bindings": {
      "F7": ["task::Spawn", { "task_name": "CU: dtb_build" }],
      "Ctrl-F7": ["task::Spawn", { "task_name": "CU: dtb_elab" }],
      "Shift-F7": ["task::Spawn", { "task_name": "CU: dtb_run" }]
    }
  }
]
