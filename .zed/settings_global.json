// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": false,
  "file_scan_exclusions": [

    // Bitstream project
    // "**/bitstream-mipi-usb/rtl/core/ulpi",

    "**/bitstream-mipi-usb/.git",
    "**/bitstream-mipi-usb/.gitignore",
    "**/bitstream-mipi-usb/sim",
    "**/bitstream-mipi-usb/syn",
    "**/bitstream-mipi-usb/lib",
    "**/bitstream-mipi-usb/README.md",
    "**/xsim.dir",
    "**/xvlog.*",

    "**/bitstream-mipi-usb/mc/vitis_ws",
    "**/__pycache__/*",


    "**/Vitis-HLS-Introductory-Examples",
    "**/*.pb",
    "**/_algo",
    "**/.python_venv",
    "**/ams_scripts",
    "**/flash_generator",
    "**/ssh_connections",
    "**/safe",
    "**/archive",
    "**/calibration_data",
    "**/doc",
    "**/tmp",
  ],


  "autosave": "on_focus_change",
  "project_panel": {
    "dock": "left",
    "diagnostics": "all"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Macchiato",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "ultracode": false,
        "fast": false
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "allow_all": "on"
      },
      "type": "registry"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "light",
    "light": "My Github Ezio",
    "dark": "Base16 Black Metal",
  },

  "theme_overrides": {
    "macEzio": {
      "scrollbar.thumb.background": "#45475a80",
    },
    "My Github Ezio": {
      "scrollbar.thumb.background": "#45475a80",
      "editor.background": "#c0c0c0",
    }
  },

  "languages": {
    "SystemVerilog": {
      // "language_servers": ["verible", "veridian", "svls", "slang"]
      "language_servers": ["slang"],
      "enable_language_server": true,
      "preferred_line_length": 100,
    }
  },



  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "hint"
    }
  },


"scrollbar": {
    "axes": {
      "vertical": true
    },
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "diagnostics": "all"
  },

  "tab_size": 2,
  "hard_tabs": false
}
